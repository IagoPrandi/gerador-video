# Copie este arquivo para .env.local e adicione sua chave localmente.
OPENROUTER_API_KEY=coloque_sua_chave_aqui

# Modelo de vídeo usado pela OpenRouter. Pode trocar por outro modelo compatível.
OPENROUTER_VIDEO_MODEL=kwaivgi/kling-v3.0-std

# Opcional: usado apenas para referência local.
NEXT_PUBLIC_APP_URL=http://localhost:3000
